# PostgreSQL connection string from Neon or another managed PostgreSQL provider
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=4000
NODE_ENV=development
# Optional only if the frontend is hosted on a different origin. Same-origin deployment is recommended.
# CLIENT_ORIGIN=https://your-frontend.example.com
